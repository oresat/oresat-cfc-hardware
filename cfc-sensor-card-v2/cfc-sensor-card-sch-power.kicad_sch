	)
	(text "Power Up/Down sequencer:\n- Neg inputs of comparator are set to consecutive \nreference values by voltage divider\n- Pos inputs are all brought up at a fixed rate\nby the RC circuit\n- Comparators with lower reference voltage are\nenabled first"
		(exclude_from_sim no)
		(at 106.68 127.254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
